# PostgreSQL connection string used by Prisma and the app.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventarios?schema=public"

# Nubefact API (electronic vouchers to SUNAT). Without these variables the
# app still registers sales locally but skips SUNAT emission.
NUBEFACT_URL="https://api.nubefact.com/api/v1/your-route-id"
NUBEFACT_TOKEN="your-nubefact-token"

# Decolecta API (RENIEC DNI / SUNAT RUC lookups). Without this token the
# "Consultar DNI/RUC" button in the customer form returns a 503.
DECOLECTA_TOKEN="your-decolecta-token"

# Cloudinary (product image uploads). The cloud name and API key are public
# (used by the upload widget); the secret signs uploads on the server. Without
# these variables the image upload in the product form is disabled.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# NextAuth (GitHub OAuth). Create an OAuth App in GitHub and set its
# "Authorization callback URL" to http://localhost:3000/api/auth/callback/github
# (or your production URL). Generate NEXTAUTH_SECRET with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Secret used to sign the JWT stored in the httpOnly "auth_token" cookie after
# a successful GitHub login. It must NOT be the same as NEXTAUTH_SECRET.
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret"

# Single admin account for the email/password login. The password is never
# stored in plain text: ADMIN_PASSWORD_HASH_B64 is the base64 encoding of a
# bcrypt hash (base64 is used because Next.js expands "$" in .env values).
# Generate it with:
#   npm run auth:hash -- "your-password"
# The demo account used in this project is admin@admin.com / 12345678.
ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD_HASH_B64="your-base64-bcrypt-hash"

# Resend (welcome email sent to each newly registered user). Create an API key
# at https://resend.com/api-keys. Without it, registration still works but the
# email is skipped and the error is logged on the server.
RESEND_API_KEY="your-resend-api-key"

# Sender address for the welcome email. Use a verified domain in production;
# the default onboarding@resend.dev only delivers to the Resend account owner.
RESEND_FROM_EMAIL="Inventarios <onboarding@resend.dev>"
