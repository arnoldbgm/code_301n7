// Prisma schema for the inventory app.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Customer document type for SUNAT (Peru).
enum DocumentType {
  DNI
  RUC

  @@map("document_type")
}

// "Comprobante de pago" type sent to SUNAT via Nubefact.
enum VoucherType {
  BOLETA
  FACTURA

  @@map("voucher_type")
}

// Application user role. The first admin is SUPER_USUARIO; everyone else
// (manual sign-ups or other login methods) defaults to USUARIO.
enum UserRole {
  SUPER_USUARIO @map("super_usuario")
  USUARIO       @map("usuario")

  @@map("user_role")
}

model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  dni          String       @unique @db.VarChar(11) // DNI (8 digits) or RUC (11 digits)
  documentType DocumentType @default(DNI) @map("document_type")
  businessName String?      @map("business_name") @db.VarChar(150) // Razon social, only for RUC customers
  firstName    String       @map("first_name") @db.VarChar(80)
  lastName     String       @map("last_name") @db.VarChar(80)
  address      String       @db.VarChar(200)
  phone        String?      @db.VarChar(20)
  email        String?      @unique @db.VarChar(120)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  vouchers Voucher[]

  @@map("customers")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(120)
  imageUrl  String?  @map("image_url") @db.VarChar(500) // Cloudinary secure_url
  price     Decimal  @db.Decimal(12, 2) // Selling price, IGV included
  stock     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  voucherItems VoucherItem[]

  @@map("products")
}

model Voucher {
  id         String      @id @default(uuid()) @db.Uuid
  type       VoucherType
  series     String      @db.VarChar(4) // e.g. "BBB1" (boleta) or "FFF1" (factura)
  number     Int // Correlativo, unique per series
  issuedAt   DateTime    @default(now()) @map("issued_at")
  customerId String      @map("customer_id") @db.Uuid
  customer   Customer    @relation(fields: [customerId], references: [id])
  subtotal   Decimal     @db.Decimal(12, 2) // sin IGV
  igv        Decimal     @db.Decimal(12, 2)
  total      Decimal     @db.Decimal(12, 2) // con IGV
  // Soft annulment: null = active, set when the voucher is annulled.
  annulledAt DateTime?   @map("annulled_at")
  // SUNAT emission data returned by Nubefact (null = not sent to SUNAT).
  sunatAccepted    Boolean? @map("sunat_accepted")
  sunatDescription String?  @map("sunat_description") @db.VarChar(500)
  enlacePdf        String?  @map("enlace_pdf") @db.VarChar(500)
  enlaceXml        String?  @map("enlace_xml") @db.VarChar(500)
  enlaceCdr        String?  @map("enlace_cdr") @db.VarChar(500)
  codigoHash       String?  @map("codigo_hash") @db.VarChar(250)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  items VoucherItem[]

  @@unique([series, number])
  @@map("vouchers")
}

model VoucherItem {
  id        String  @id @default(uuid()) @db.Uuid
  voucherId String  @map("voucher_id") @db.Uuid
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("voucher_items")
}

// App user. `password` is a bcrypt hash and stays null for OAuth-only accounts
// (e.g. GitHub), which never type a password.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(120)
  password  String?  @db.VarChar(255)
  role      UserRole @default(USUARIO)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
